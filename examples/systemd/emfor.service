# Example systemd unit for the emfor daemon; see docs/deploy/daemon.md,
# section "Running under systemd". Copy it to
# /etc/systemd/system/emfor.service, then:
#
#   useradd --system --no-create-home --shell /usr/sbin/nologin emfor
#   systemctl daemon-reload
#   systemctl enable --now emfor
#
# "systemctl reload emfor" checks the config first and fails without
# touching the daemon if it is invalid; otherwise it sends SIGHUP and the
# daemon applies the config if it is fully valid. [store], [dns] listen
# and [metrics] listen changes need "systemctl restart emfor".
#
# Logs (the daemon writes them to stderr) go to the journal:
#   journalctl -u emfor

[Unit]
Description=emfor health-check daemon
# Checks reach backends over the network.
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=emfor
Group=emfor
ExecStartPre=/usr/local/bin/emfor check-config --config /etc/emfor/emfor.toml
ExecStart=/usr/local/bin/emfor server --config /etc/emfor/emfor.toml
ExecReload=/usr/local/bin/emfor check-config --config /etc/emfor/emfor.toml
ExecReload=/bin/kill -HUP $MAINPID

# Exit status 1 (a listen address in use, the store held by another emfor)
# and 2 (invalid config) do not go away by trying again.
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=1 2

# Checks, plugins and DNS and metrics connections all use file descriptors;
# systemd's default soft limit is 1024. DNS over TCP serves at most 128
# connections at once.
LimitNOFILE=65536

# /var/lib/emfor, owned by the emfor user, for the default [store] path.
# Mode 0755 so applications using an emfor client can reach the store; the
# store files themselves get [store] file_mode and lock_file_mode. Do not
# use DynamicUser=: it puts the directory under /var/lib/private (mode
# 0700), out of the clients' reach.
StateDirectory=emfor
StateDirectoryMode=0755

# Hardening. Plugins run with the same restrictions; relax them if a
# plugin needs more (for example ProtectHome= for a plugin in a home
# directory). A [store] path outside /var/lib/emfor needs
# ReadWritePaths=<its directory>.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
# The default DNS (5300) and metrics (5301) ports need no privilege. To
# listen on port 53, replace the empty CapabilityBoundingSet= with:
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
