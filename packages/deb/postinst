#!/bin/sh
# deb: create the emfor user, then the debhelper section (cargo-deb replaces
# the marker line below, and only the first place the marker is written, with
# the systemd enable and start).
set -e

case "$1" in
configure)
    if ! getent passwd emfor >/dev/null; then
        adduser --system --group --no-create-home --home /nonexistent \
            --shell /usr/sbin/nologin --gecos "emfor daemon" emfor
    fi
    # The config directory must be owned by root and not writable by others,
    # or emfor refuses it (docs/manual/05-configuring.md).
    chown root:root /etc/emfor /etc/emfor/conf.d
    chmod 0755 /etc/emfor /etc/emfor/conf.d
    ;;
esac

#DEBHELPER#

exit 0
